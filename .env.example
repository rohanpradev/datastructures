# AI SDK routes provider/model IDs through Vercel AI Gateway.
# For local development, set a Vercel AI Gateway API key. Vercel deployments
# can authenticate with Vercel OIDC. No OpenAI or Anthropic provider keys needed.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.5

# Local durable state. Parent directories are created automatically.
AI_DATABASE_PATH=data/typescript-tutor.sqlite
AI_PORT=3001
