{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/*.test.ts",
			"!scripts",
			"!practice",
			"!.vscode",
			"!.zed"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off"
			},
			"style": {
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"strictCase": true,
						"filenameCases": ["kebab-case"]
					}
				},
				"noNonNullAssertion": "off",
				"noParameterAssign": "error"
			},
			"complexity": {
				"useLiteralKeys": "off",
				"useOptionalChain": "off"
			}
		}
	}
}
