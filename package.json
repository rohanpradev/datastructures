{
	"name": "code-practice",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.3",
	"scripts": {
		"course:lab": "bun --watch run src/course/realtime-lab.ts",
		"course:test": "bun test src/course src/data-structures/tests/fenwick-tree.test.ts src/data-structures/tests/segment-tree.test.ts src/algorithms/tests/shortest-path.test.ts src/node-concepts/test/durable-event-log.test.ts",
		"ai:dev": "bun --watch run src/ai/server.ts",
		"ai:start": "bun run src/ai/server.ts",
		"db:generate": "bunx drizzle-kit generate",
		"db:migrate": "bun run src/ai/db/migrate.ts",
		"db:studio": "bunx drizzle-kit studio",
		"dev": "bun run src/node-concepts/server.ts",
		"check": "bun run lint && bun run typecheck && bun run typecheck:tsc && bun run docs:check && bun run practice:audit && bun run test:ci",
		"docs:check": "bun run scripts/validate-docs.ts",
		"fix": "bun ./node_modules/@biomejs/biome/bin/biome check --write .",
		"format": "bun ./node_modules/@biomejs/biome/bin/biome format --write .",
		"lint": "bun ./node_modules/@biomejs/biome/bin/biome check .",
		"test": "bun test",
		"test:ai": "bun test src/ai/test",
		"test:ai-exercises": "bun test src/ai/test/executable-problems.test.ts",
		"test:algorithms": "bun test src/algorithms/tests",
		"test:bun": "bun test src/node-concepts/test/bun-runtime.test.ts",
		"test:ci": "bun test --coverage --reporter=dots",
		"test:changed": "bun test --changed",
		"test:concepts": "bun test src/javascript-concepts/test src/typescript-concepts/test src/node-concepts/test",
		"test:concepts:smoke": "bun test --randomize --rerun-each=3 src/javascript-concepts/test src/typescript-concepts/test src/node-concepts/test",
		"test:coverage": "bun test --coverage",
		"test:data-structures": "bun test src/data-structures/tests",
		"test:js": "bun test src/javascript-concepts/test",
		"test:node": "bun test src/node-concepts/test",
		"test:parallel": "bun test --parallel",
		"test:isolated": "bun test --isolate",
		"test:system-design": "bun test src/node-concepts/test/system-design.test.ts src/node-concepts/test/system-design-failures.test.ts",
		"typecheck": "bun --check",
		"typecheck:tsc": "tsc --noEmit",
		"practice": "bun run scripts/generate-practice.ts",
		"practice:audit": "bun run scripts/generate-practice.ts -- --audit-targets",
		"practice:easy": "bun run scripts/generate-practice.ts -- --random easy",
		"practice:hard": "bun run scripts/generate-practice.ts -- --random hard",
		"practice:list": "bun run scripts/generate-practice.ts -- --list",
		"practice:manifest": "bun run scripts/generate-practice.ts -- --manifest",
		"practice:dashboard": "bun run scripts/generate-practice.ts -- --dashboard",
		"practice:medium": "bun run scripts/generate-practice.ts -- --random medium",
		"practice:random": "bun run scripts/generate-practice.ts -- --random",
		"practice:next": "bun run scripts/generate-practice.ts -- --next",
		"practice:review": "bun run scripts/generate-practice.ts -- --review",
		"practice:grade": "bun run scripts/generate-practice.ts -- --grade",
		"practice:run": "bun run scripts/generate-practice.ts -- --run",
		"practice:smoke": "bun run scripts/generate-practice.ts -- --smoke-test",
		"practice:status": "bun run scripts/generate-practice.ts -- --status",
		"practice:validate": "bun run scripts/generate-practice.ts -- --validate-all-focused",
		"practice:watch": "bun run scripts/generate-practice.ts -- --watch",
		"generate:practice": "bun run scripts/generate-practice.ts"
	},
	"dependencies": {
		"@langchain/core": "^1.2.19",
		"@langchain/langgraph": "^1.5.1",
		"@langchain/langgraph-checkpoint": "^1.2.0",
		"@modelcontextprotocol/server": "2.3.1",
		"@scalar/api-reference": "^1.75.0",
		"ai": "^7.0.146",
		"drizzle-orm": "1.0.0-rc.4",
		"zod": "4.6.7"
	},
	"overrides": {
		"@ai-sdk/provider-utils@4.0.5": "4.0.33"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.3",
		"drizzle-kit": "1.0.0-rc.4",
		"typescript": "7.0.2"
	}
}
